<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Teks ===== -->
    <style name="TextAppearance.Simpanin.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/simpanin_on_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Simpanin.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/simpanin_on_primary_muted</item>
    </style>

    <style name="TextAppearance.Simpanin.Header" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/simpanin_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Simpanin.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/simpanin_text_secondary</item>
    </style>

    <style name="TextAppearance.Simpanin.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===== Toolbar (transparan, di atas header gradien) ===== -->
    <style name="Widget.Simpanin.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextColor">@color/simpanin_on_primary</item>
    </style>

    <style name="ThemeOverlay.Simpanin.Toolbar" parent="">
        <item name="colorControlNormal">@color/simpanin_on_primary</item>
    </style>

    <!-- ===== Tombol ===== -->
    <style name="Widget.Simpanin.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Simpanin.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- ===== Chip filter ===== -->
    <style name="Widget.Simpanin.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Simpanin.Pill</item>
    </style>

    <!-- ===== Kartu ===== -->
    <style name="Widget.Simpanin.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/simpanin_surface</item>
    </style>

    <!-- ===== Input teks ===== -->
    <style name="Widget.Simpanin.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
    </style>

    <!-- ===== Bentuk ===== -->
    <style name="ShapeAppearance.Simpanin.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Simpanin.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>